{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bank-of-dad",
  "main": "build/cloudflare_worker.py",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["python_workers"],
  "build": {"command": "python prepare.py", "watch_dir": ["../app.py", "../bank.py", "../config.py", "../db.py", "../hosted.py", "../hosted_access.py", "../guest_bank.py", "../owner_panel.py", "../cloudflare_owner.py", "../cloudflare_auth.py", "../cloudflare_billing.py", "../cloudflare_hosted.py", "../cloudflare_sql.py", "../cloudflare_worker.py", "../cloudflare_security.py", "../templates", "prepare.py"]},
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "../static", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "FAMILIES", "class_name": "FamilyBank"}, {"name": "DIRECTORY", "class_name": "Directory"}]},
  "ratelimits": [
    {"name": "BOD_INGRESS_LIMIT", "namespace_id": "194201", "simple": {"limit": 60, "period": 60}},
    {"name": "BOD_CREATE_LIMIT", "namespace_id": "194202", "simple": {"limit": 3, "period": 60}},
    {"name": "BOD_CREATE_GLOBAL_LIMIT", "namespace_id": "194203", "simple": {"limit": 30, "period": 60}}
  ],
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["FamilyBank"]}, {"tag": "v2", "new_sqlite_classes": ["Directory"]}],
  "vars": {"BOD_PUBLIC_ORIGIN": "http://127.0.0.1:8787", "BOD_LOCAL_ONLY": "true", "BOD_SUPPORT_URL": "mailto:support@thebankofdad.app"}
}
